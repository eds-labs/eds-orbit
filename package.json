{
  "name": "eds-orbit",
  "version": "0.1.0-rc.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "dev:web": "pnpm --dir apps/web dev",
    "dev:worker": "tsx apps/worker/src/main.ts",
    "db:generate": "prisma generate --config packages/db/prisma.config.ts",
    "db:migrate": "prisma migrate deploy --config packages/db/prisma.config.ts",
    "typecheck": "tsc --noEmit && pnpm --dir apps/web typecheck",
    "lint": "tsc --noEmit && node scripts/source-check.mjs",
    "format": "prettier --write apps packages evals infra/*.yml",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run integration",
    "test:e2e": "playwright test",
    "build": "pnpm db:generate && tsc --noEmit && pnpm --dir apps/web build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "framework:check": "PYTHONDONTWRITEBYTECODE=1 python3 scripts/check_framework.py --require-full-validation",
    "api:generate": "tsx scripts/openapi.ts && openapi-typescript packages/schemas/openapi.json -o packages/api-client/src/generated.ts",
    "local:setup": "tsx scripts/local-setup.ts",
    "db:deploy": "tsx scripts/db-deploy.ts",
    "secrets:check": "python3 scripts/check-secrets.py",
    "dependencies:inventory": "node scripts/dependency-inventory.mjs"
  },
  "dependencies": {
    "@prisma/client": "7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "fastify": "5.12.5",
    "better-auth": "1.7.5",
    "bullmq": "6.3.6",
    "pg": "8.23.0",
    "openai": "7.17.0",
    "zod": "4.6.5",
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/swagger": "9.8.1",
    "mammoth": "1.12.3",
    "pdfjs-dist": "6.3.289",
    "sanitize-html": "2.17.7",
    "csv-parse": "7.0.2",
    "ipaddr.js": "2.5.0",
    "ioredis": "6.0.0"
    ,"prisma": "7.10.0"
    ,"tsx": "4.23.13"
  },
  "devDependencies": {
    "vitest": "5.0.1",
    "typescript": "6.0.3",
    "openapi-typescript": "7.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.3",
    "@types/pg": "8.23.1",
    "@types/sanitize-html": "2.16.1",
    "prettier": "3.9.7"
  }
}
