# n8n settings for the Orbit customer context gateway (ADR 0011).
# Placeholders only: real values live in Coolify (locked secrets) and in the
# password manager, never in Git. Runbook: docs/deployment/N8N_CUSTOMER_CONTEXT.md

# --- Instance (compare with the existing Coolify n8n) ------------------------
N8N_HOST=n8n.example.com
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.example.com/
N8N_PROXY_HOPS=1
GENERIC_TIMEZONE=UTC
# Back up this key separately: without it no stored n8n credential decrypts.
N8N_ENCRYPTION_KEY=<generated, password manager>

# PostgreSQL 17 or newer (n8n 2.44 warns on 16 as unsupported).
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=<generated>

# Data minimization: no execution data (customer data) is stored, in addition
# to the per-workflow settings of the generated workflows.
EXECUTIONS_DATA_SAVE_ON_SUCCESS=none
EXECUTIONS_DATA_SAVE_ON_ERROR=none
EXECUTIONS_DATA_SAVE_ON_PROGRESS=false
EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=false
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=24
EXECUTIONS_TIMEOUT=30
EXECUTIONS_TIMEOUT_MAX=60
N8N_RUNNERS_TASK_TIMEOUT=60

# Hardening: no telemetry, templates, version checks or public API.
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
N8N_TEMPLATES_ENABLED=false
N8N_PUBLIC_API_DISABLED=true
N8N_COMMUNITY_PACKAGES_ENABLED=false
N8N_SECURE_COOKIE=true

# The gateway's Code nodes need crypto and $env (see the runbook: only the
# owner may edit workflows while env access is on).
NODE_FUNCTION_ALLOW_BUILTIN=crypto
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# --- Customer context gateway (workflow A) ----------------------------------
# JSON array, one entry per Orbit integration (Orbit connection id):
# [{"integrationId":"<uuid>","adapter":"uliquid-desk"|"familyplan",
#   "tokenSha256":"<sha256 hex of the integration bearer token>",
#   "signingSecret":"<the integration signing secret, >= 32 chars>"}]
CC_GATEWAY_INTEGRATIONS=[]

# --- uLiquid Desk adapter (workflow B) --------------------------------------
CC_DESK_BASE_URL=https://api.desk.uliquid.vip
# Desk's dctx_ client token (Desk stores only its hash).
CC_DESK_TOKEN=<dctx_…>
# Optional: Desk's budget in ms (default 2500, at most 7000). A real Desk
# context can take longer than 2.5 s; with 6500 set the Orbit integration
# timeout to 8000.
CC_DESK_TIMEOUT_MS=2500

# --- FamilyPlan adapter (workflow C) ----------------------------------------
CC_FAMILYPLAN_FUNCTION_URL=https://<project-ref>.supabase.co/functions/v1/support-customer-context
# FamilyPlan's fpctx_ service token (the function stores only its hash).
CC_FAMILYPLAN_TOKEN=<fpctx_…>
