                  "type": "integer",
                },
                "sourceIds": {
                  "description": "Approved source IDs returned by knowledge_search",
                  "items": {
                    "type": "string",
                  },
                  "minItems": 1,
                  "type": "array",
                },
                "startAt": {
                  "description": "ISO 8601 UTC timestamp",
                  "type": "string",
                },
                "targetAction": {
                  "description": "Exact primary CTA from the current marketing profile",
                  "type": "string",
                },
                "targetUrl": {
                  "description": "Exact official target URL from the current marketing profile",
                  "type": "string",
                },
                "title": {
                  "type": "string",
                },
              },
              "required": [
                "title",
                "goal",
                "audience",
                "product",
                "allowedTopics",
                "language",
                "channels",
                "startAt",
                "endAt",
                "maxContents",
                "targetAction",
                "targetUrl",
                "sourceIds",
                "assetIds",
                "contentType",
                "campaignType",
                "profileVersion",
              ],
              "type": "object",
            },
          },
          "required": [
            "mission",
            "factIds",
          ],
          "type": "object",
        },
        "strict": true,
        "type": "function",
      },
      {
        "description": "One draft per channel for the user's goal; the server fills CTA, link, language, timing. Nothing runs before the user confirms; nothing is published.",
        "name": "request_content_package",
        "parameters": {
          "additionalProperties": false,
