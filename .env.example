# Copy only this example, never another application's secrets.
# Local developer setup: node scripts/local-config.mjs creates ignored .runtime/local.env.
# Production operators provide unique generated secrets through their secret store.
DATABASE_URL=
AUTH_DATABASE_URL=
MIGRATION_DATABASE_URL=
DB_PASSWORD=
REDIS_URL=redis://redis:6379
AUTH_SECRET=
CREDENTIAL_KEY=
ORBIT_SETUP_TOKEN=
APP_ORIGIN=https://orbit.example.org
ORBIT_HOSTNAME=orbit.example.org
EXECUTION_MODE=test
ENABLE_EXTERNAL_WRITES=false
PUBLISHER_INSTANCE_ID=
LIVE_RAG_EVAL_PASSED=false
# OpenAI provisioning and explicit test budget are separate owner decisions.
OPENAI_API_KEY=
OPENAI_VERIFIED_MODELS=
OPENAI_RATE_CARD_JSON=
