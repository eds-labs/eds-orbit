# Manual override/reference file. Do not commit a filled-in copy.
# A fresh Coolify resource generates unique database and application secrets from
# docker-compose.yml. Only set the values below when deliberately overriding them.
# All three database URLs must target postgres:5432 and the same POSTGRES_DB.
DATABASE_URL=postgresql://orbit_app:REPLACE_WITH_24_PLUS_CHAR_PASSWORD@postgres:5432/orbit
AUTH_DATABASE_URL=postgresql://orbit_auth:REPLACE_WITH_24_PLUS_CHAR_PASSWORD@postgres:5432/orbit
MIGRATION_DATABASE_URL=postgresql://orbit_migrator:REPLACE_WITH_24_PLUS_CHAR_PASSWORD@postgres:5432/orbit
DB_PASSWORD=REPLACE_WITH_THE_ORBIT_MIGRATOR_PASSWORD
POSTGRES_DB=orbit
REDIS_URL=redis://redis:6379
AUTH_SECRET=
CREDENTIAL_KEY=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
ORBIT_SETUP_TOKEN=
ORBIT_RELEASE_APPROVAL=
APP_ORIGIN=https://eds-orbit.apps.eds-labs.io
PUBLISHER_INSTANCE_ID=eds-orbit-production-1
QUEUE_NAMESPACE=orbit
# Pino log level for the API (trace|debug|info|warn|error|fatal|silent). Default: info.
LOG_LEVEL=info
# Keep the following defaults until their separate operational approvals exist.
EXECUTION_MODE=test
ENABLE_EXTERNAL_WRITES=false
# Allows only owner-confirmed Postiz draft handoffs; never schedules or publishes.
ENABLE_POSTIZ_DRAFTS=false
LIVE_RAG_EVAL_PASSED=false
# Orbit Chat may offer new content packages (one click, draft-only). Existing packages keep running when off.
ORBIT_CONTENT_PACKAGES=false
ORBIT_TOOL_SEARCH=false
ORBIT_AGENTS=false
# Assignment images: true sends approved style references to the image model (images.edit); false uses the stored style description.
ORBIT_IMAGE_REFERENCES=false
# The review agent may approve assignment posts in place of the owner; true only after the review eval passed (Approval J).
ORBIT_AGENT_REVIEW_AUTHORITY=false
# Owners may switch modules per project; recorded only, not yet enforced (WP1.4).
ORBIT_MODULES=false
ORBIT_MODULE_ROLES=false
# Orbit as OAuth 2.1 authorization server for MCP clients (Track M WP-M1); false leaves /api/auth unchanged.
ORBIT_MCP_OAUTH=false
# Dynamic client registration on top of Client ID Metadata Documents; keep false unless explicitly approved.
ORBIT_MCP_DCR=false
# Canonical MCP resource and token audience (https, no query or fragment); defaults to APP_ORIGIN + /mcp when blank.
MCP_RESOURCE=
# Comma-separated hosts (exact or subdomain) whose Client ID Metadata Documents Orbit may fetch.
ORBIT_MCP_CIMD_HOSTS=chatgpt.com
# Separate MCP gateway process (Track M WP-M2); it serves tools only when this and ORBIT_MCP_OAUTH are true, otherwise only /healthz (disabled).
ORBIT_MCP_GATEWAY=false
# Port of the gateway process (the reverse proxy routes /mcp to it).
MCP_PORT=4312
# Where the gateway fetches the token signing keys; blank = APP_ORIGIN + /api/auth/jwks. Compose sets http://api:4311/api/auth/jwks for the mcp service.
MCP_JWKS_URL=
# Web only: where the web app forwards /.well-known/oauth-protected-resource[/mcp] (the mcp service); blank = http://mcp:4312.
ORBIT_MCP_ORIGIN=
# Comma-separated browser origins allowed to call the gateway; empty allows none.
ORBIT_MCP_ALLOWED_ORIGINS=
# Central switch for MCP proposal tools (Track M WP-M4); false hides and refuses them, status polling stays available.
ORBIT_MCP_PROPOSALS=false
# Durable delegated work orders and module operations (separate rollout).
ORBIT_MCP_TASKS=false
ORBIT_PUBLIC_INGRESS=false
# Support module (WP5.1): off until the pilot; owners still enable it per project.
ORBIT_SUPPORT=false
# Finance module: off until its rollout; owners still enable it per project.
ORBIT_FINANCE=false
# Customer context from external products (ADR 0011): off until a provider passed
# its integration test; owners bind each Support inbox separately.
ORBIT_CUSTOMER_CONTEXT=false
# Platform files (WP4.6): a separate S3-compatible bucket (Cloudflare R2) with its
# own token, never the backup bucket's. Off until the security review.
ORBIT_FILES=false
# database (default): encrypted rows in Postgres, part of the database backup.
# s3: a separate bucket; then the FILES_S3_* values below are required.
FILES_BACKEND=database
# https://<account-id>.r2.cloudflarestorage.com
FILES_S3_ENDPOINT=
FILES_S3_BUCKET=
FILES_S3_REGION=auto
FILES_S3_ACCESS_KEY_ID=
FILES_S3_SECRET_ACCESS_KEY=
# 64 hex characters (openssl rand -hex 32), separate from CREDENTIAL_KEY. In
# Coolify it is generated as SERVICE_HEX_64_FILESKEY when left blank.
FILES_ENCRYPTION_KEY=
FILES_MAX_BYTES=20971520
# All files of one project (100 MB). With the database backend they are in every
# backup; raise it only once the backup has room (docs/PLATFORM_FILES.md).
FILES_PROJECT_QUOTA_BYTES=104857600
# E-mail over SMTP/IMAP against the project's own mailbox (configured in Orbit,
# never here) and in-app member notifications (WP4.7). Off until the review.
ORBIT_EMAIL=false
ORBIT_NOTIFICATIONS=false
# Real-time fan-out over Redis for the chat SSE route (WP4.3 Part B). API and
# worker need the same value; off keeps the polling route.
ORBIT_REALTIME=false
# System administration, organization settings and invitations, and account
# self-service (ADR 0013). Off until the rollout (docs/deployment/ADMINISTRATION_ROLLOUT.md).
ORBIT_ADMINISTRATION=false
ORBIT_ACCOUNT=false
# Central connections, AI profiles and organization knowledge shares (ADR 0014).
ORBIT_CONNECTIONS=false
ORBIT_KNOWLEDGE_SHARES=false
# Optional master-key ring for connection secrets: "id:hex64,id:hex64", newest
# first. CREDENTIAL_KEY stays readable as key id "default".
CREDENTIAL_KEYS=
# Optional system SMTP account for invitations and password reset, separate
# from project mailboxes. Blank host: administrators copy the links by hand.
ORBIT_SYSTEM_SMTP_HOST=
ORBIT_SYSTEM_SMTP_PORT=587
ORBIT_SYSTEM_SMTP_TLS=starttls
ORBIT_SYSTEM_SMTP_USER=
ORBIT_SYSTEM_SMTP_PASSWORD=
ORBIT_SYSTEM_SMTP_FROM=
ORBIT_SYSTEM_SMTP_FROM_NAME=Orbit
# Optional: leave blank unless OpenAI provisioning, budget and model verification are approved.
OPENAI_API_KEY=
# Optional bootstrap fallback. Prefer the encrypted owner-only UI field for a
# dedicated image key; leave blank to reuse OPENAI_API_KEY.
OPENAI_IMAGE_API_KEY=
OPENAI_VERIFIED_MODELS=
OPENAI_RATE_CARD_JSON=
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_IMAGE_MAX_COST_MICROS=0
OPENAI_IMAGE_PRICE_VERIFIED_AT=
# Optional bootstrap fallback for the Anthropic Claude API; prefer the encrypted
# owner-only field under Settings → AI. Leave blank unless the credit and the
# verified models are configured there.
ANTHROPIC_API_KEY=
# Bootstrap only: which provider's tier models serve task classes without a
# saved route (openai or anthropic). The saved Orbit configuration overrides it.
AI_DEFAULT_PROVIDER=openai
# Used only by the legacy infra/compose.standalone.yml Caddy topology, never by Coolify.
ORBIT_HOSTNAME=eds-orbit.apps.eds-labs.io

# Reviewed knowledge workflow and GitHub App sources (default off).
ORBIT_KNOWLEDGE_WORKSPACE=false
