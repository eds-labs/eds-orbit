# Manual override/reference file. Do not commit a filled-in copy.
# A fresh Coolify resource generates unique database and application secrets from
# docker-compose.yml. Only set the values below when deliberately overriding them.
# All three database URLs must target postgres:5432 and the same POSTGRES_DB.
DATABASE_URL=postgresql://orbit_app:REPLACE_WITH_24_PLUS_CHAR_PASSWORD@postgres:5432/orbit
AUTH_DATABASE_URL=postgresql://orbit_auth:REPLACE_WITH_24_PLUS_CHAR_PASSWORD@postgres:5432/orbit
MIGRATION_DATABASE_URL=postgresql://orbit_migrator:REPLACE_WITH_24_PLUS_CHAR_PASSWORD@postgres:5432/orbit
DB_PASSWORD=REPLACE_WITH_THE_ORBIT_MIGRATOR_PASSWORD
POSTGRES_DB=orbit
REDIS_URL=redis://redis:6379
AUTH_SECRET=
CREDENTIAL_KEY=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
ORBIT_SETUP_TOKEN=
ORBIT_RELEASE_APPROVAL=
APP_ORIGIN=https://eds-orbit.apps.eds-labs.io
PUBLISHER_INSTANCE_ID=eds-orbit-production-1
QUEUE_NAMESPACE=orbit
# Pino log level for the API (trace|debug|info|warn|error|fatal|silent). Default: info.
LOG_LEVEL=info
# Keep the following defaults until their separate operational approvals exist.
EXECUTION_MODE=test
ENABLE_EXTERNAL_WRITES=false
# Allows only owner-confirmed Postiz draft handoffs; never schedules or publishes.
ENABLE_POSTIZ_DRAFTS=false
LIVE_RAG_EVAL_PASSED=false
# Orbit Chat may offer new content packages (one click, draft-only). Existing packages keep running when off.
ORBIT_CONTENT_PACKAGES=false
ORBIT_TOOL_SEARCH=false
ORBIT_AGENTS=false
# Assignment images: true sends approved style references to the image model (images.edit); false uses the stored style description.
ORBIT_IMAGE_REFERENCES=false
# The review agent may approve assignment posts in place of the owner; true only after the review eval passed (Approval J).
ORBIT_AGENT_REVIEW_AUTHORITY=false
# Owners may switch modules per project; recorded only, not yet enforced (WP1.4).
ORBIT_MODULES=false
ORBIT_MODULE_ROLES=false
ORBIT_PUBLIC_INGRESS=false
# Support module (WP5.1): off until the pilot; owners still enable it per project.
ORBIT_SUPPORT=false
# Platform files (WP4.6): a separate S3-compatible bucket (Cloudflare R2) with its
# own token, never the backup bucket's. Off until the security review.
ORBIT_FILES=false
# https://<account-id>.r2.cloudflarestorage.com
FILES_S3_ENDPOINT=
FILES_S3_BUCKET=
FILES_S3_REGION=auto
FILES_S3_ACCESS_KEY_ID=
FILES_S3_SECRET_ACCESS_KEY=
# 64 hex characters (openssl rand -hex 32), separate from CREDENTIAL_KEY.
FILES_ENCRYPTION_KEY=
FILES_MAX_BYTES=20971520
# E-mail over SMTP/IMAP against the project's own mailbox (configured in Orbit,
# never here) and in-app member notifications (WP4.7). Off until the review.
ORBIT_EMAIL=false
ORBIT_NOTIFICATIONS=false
# Real-time fan-out over Redis for the chat SSE route (WP4.3 Part B). API and
# worker need the same value; off keeps the polling route.
ORBIT_REALTIME=false
# Optional: leave blank unless OpenAI provisioning, budget and model verification are approved.
OPENAI_API_KEY=
# Optional bootstrap fallback. Prefer the encrypted owner-only UI field for a
# dedicated image key; leave blank to reuse OPENAI_API_KEY.
OPENAI_IMAGE_API_KEY=
OPENAI_VERIFIED_MODELS=
OPENAI_RATE_CARD_JSON=
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_IMAGE_MAX_COST_MICROS=0
OPENAI_IMAGE_PRICE_VERIFIED_AT=
# Used only by the legacy infra/compose.standalone.yml Caddy topology, never by Coolify.
ORBIT_HOSTNAME=eds-orbit.apps.eds-labs.io
