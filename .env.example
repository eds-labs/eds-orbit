# Manual override/reference file. Do not commit a filled-in copy.
# A fresh Coolify resource generates unique database and application secrets from
# docker-compose.yml. Only set the values below when deliberately overriding them.
# All three database URLs must target postgres:5432 and the same POSTGRES_DB.
DATABASE_URL=postgresql://orbit_app:REPLACE_WITH_24_PLUS_CHAR_PASSWORD@postgres:5432/orbit
AUTH_DATABASE_URL=postgresql://orbit_auth:REPLACE_WITH_24_PLUS_CHAR_PASSWORD@postgres:5432/orbit
MIGRATION_DATABASE_URL=postgresql://orbit_migrator:REPLACE_WITH_24_PLUS_CHAR_PASSWORD@postgres:5432/orbit
DB_PASSWORD=REPLACE_WITH_THE_ORBIT_MIGRATOR_PASSWORD
POSTGRES_DB=orbit
REDIS_URL=redis://redis:6379
AUTH_SECRET=
CREDENTIAL_KEY=
ORBIT_SETUP_TOKEN=
ORBIT_RELEASE_APPROVAL=
APP_ORIGIN=https://eds-orbit.apps.eds-labs.io
PUBLISHER_INSTANCE_ID=eds-orbit-production-1
QUEUE_NAMESPACE=orbit
# Keep the following defaults until their separate operational approvals exist.
EXECUTION_MODE=test
ENABLE_EXTERNAL_WRITES=false
LIVE_RAG_EVAL_PASSED=false
# Optional: leave blank unless OpenAI provisioning, budget and model verification are approved.
OPENAI_API_KEY=
OPENAI_VERIFIED_MODELS=
OPENAI_RATE_CARD_JSON=
# Used only by the legacy infra/compose.standalone.yml Caddy topology, never by Coolify.
ORBIT_HOSTNAME=eds-orbit.apps.eds-labs.io
