generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String            @id
  name               String
  email              String            @unique
  emailVerified      Boolean           @default(false)
  image              String?
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(3)
  /// Better Auth admin plugin (ADR 0013): 'user' or 'admin' (system administrator).
  role               String            @default("user")
  banned             Boolean           @default(false)
  banReason          String?
  banExpires         DateTime?         @db.Timestamptz(3)
  /// Personal interface language ('en' or 'de'); null follows the browser.
  locale             String?
  sessions           Session[]
  accounts           Account[]
  memberships        WorkspaceMember[]
  projectMemberships ProjectMember[]
  chatConversations ChatConversation[]
  oauthClients       OauthClient[]
  oauthAccessTokens  OauthAccessToken[]
  oauthRefreshTokens OauthRefreshToken[]
  oauthConsents      OauthConsent[]
  mcpGrants          McpGrant[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String
  /// Required by the admin plugin schema; Orbit never offers impersonation.
  impersonatedBy String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthAccessTokens  OauthAccessToken[]
  oauthRefreshTokens OauthRefreshToken[]

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

model Workspace {
  id        String            @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime          @default(now()) @db.Timestamptz(3)
  members   WorkspaceMember[]
  projects  Project[]
  mcpGrants McpGrant[]
  invitations Invitation[]
  connections Connection[]
  connectionGrants ConnectionGrant[]
  aiProfile   AiProfile?
  aiModelPrices AiModelPrice[]
  aiBudget    OrganizationAiBudget?
  aiSpendCounters OrganizationSpendCounter[]
}

model WorkspaceMember {
  workspaceId String    @db.Uuid
  userId      String
  role        String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
}

model Project {
  id               String              @id @default(uuid()) @db.Uuid
  workspaceId      String              @db.Uuid
  name             String
  timezone         String              @default("UTC")
  /// The default content language; one of contentLanguages.
  language         String              @default("en")
  /// The project's content languages (language tags), the default among them.
  contentLanguages String[]            @default(["en"])
  /// Public profile links [{type,label,url}] (packages/schemas project-settings); not publishing channels.
  links            Json                @default("[]")
  mode             String              @default("observe")
  /// 'project', or 'library' for an organization knowledge library (ADR 0014).
  kind             String              @default("project")
  paused           Boolean             @default(false)
  generation       Int                 @default(1)
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)
  /// Earliest time the worker must process this project; maintained by triggers and the worker.
  workDueAt        DateTime            @default(now()) @db.Timestamptz(3)
  workspace        Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members          ProjectMember[]
  entities         Entity[]
  outbox           Outbox[]
  budgets          BudgetReservation[]
  audits           AuditEvent[]
  knowledgeIndexes KnowledgeIndex[]
  marketingProfile ProjectMarketingProfile?
  chatConversations ChatConversation[]
  agentRuns        AgentRun[]
  modules          ProjectModule[]
  invitationGrants InvitationProjectGrant[]
  connections      Connection[]
  connectionGrants ConnectionGrant[]
  librarySharesOut KnowledgeShare[]     @relation("KnowledgeShareLibrary")
  librarySharesIn  KnowledgeShare[]     @relation("KnowledgeShareConsumer")

  @@unique([workspaceId, id])
  @@index([workDueAt])
}

/// Module activation per project (WP1.4). No row: the registry default applies.
model ProjectModule {
  id              String   @id @default(uuid()) @db.Uuid
  workspaceId     String   @db.Uuid
  projectId       String   @db.Uuid
  moduleId        String
  enabled         Boolean
  settings        Json     @default("{}")
  settingsVersion Int      @default(1)
  /// Module contract version when the row was last written.
  moduleVersion   String
  changedBy       String?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  project         Project  @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, projectId, moduleId])
}

model ChatConversation {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  projectId   String   @db.Uuid
  userId      String
  title       String   @default("New conversation")
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  project     Project  @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    ChatMessage[]
  runs        ChatRun[]
  proposals   ChatProposal[]

  @@unique([workspaceId, projectId, id])
  @@unique([workspaceId, projectId, id, userId])
  @@index([workspaceId, projectId, userId, updatedAt])
}

model ChatMessage {
  id             String           @id @default(uuid()) @db.Uuid
  workspaceId    String           @db.Uuid
  projectId      String           @db.Uuid
  userId         String
  conversationId String           @db.Uuid
  sequence       Int
  role           String
  text           String
  cards          Json             @default("[]")
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  conversation   ChatConversation @relation(fields: [workspaceId, projectId, conversationId, userId], references: [workspaceId, projectId, id, userId], onDelete: Cascade)

  @@unique([conversationId, sequence])
  @@index([workspaceId, projectId, userId, conversationId])
}

model ChatRun {
  id              String           @id @default(uuid()) @db.Uuid
  workspaceId     String           @db.Uuid
  projectId       String           @db.Uuid
  userId          String
  conversationId  String           @db.Uuid
  clientRequestId String
  jobId           String?          @db.Uuid
  status          String           @default("queued")
  partialText     String           @default("")
  sequence        Int              @default(0)
  errorCode       String?
  reservationId   String?          @db.Uuid
  transmittedAt   DateTime?        @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  conversation    ChatConversation @relation(fields: [workspaceId, projectId, conversationId, userId], references: [workspaceId, projectId, id, userId], onDelete: Cascade)

  @@unique([conversationId, clientRequestId])
  @@index([workspaceId, projectId, userId, conversationId])
}

model ChatProposal {
  id             String           @id @default(uuid()) @db.Uuid
  workspaceId    String           @db.Uuid
  projectId      String           @db.Uuid
  userId         String
  conversationId String           @db.Uuid
  groupId        String           @db.Uuid
  version        Int
  payload        Json
  payloadHash    String
  status         String           @default("proposed")
  confirmationId String?
  missionId      String?          @db.Uuid
  jobId          String?          @db.Uuid
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  confirmedAt    DateTime?        @db.Timestamptz(3)
  conversation   ChatConversation @relation(fields: [workspaceId, projectId, conversationId, userId], references: [workspaceId, projectId, id, userId], onDelete: Cascade)

  @@unique([groupId, version])
  @@unique([conversationId, confirmationId])
  @@index([workspaceId, projectId, userId, conversationId])
}

model ProjectMarketingProfile {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  projectId   String   @unique @db.Uuid
  version     Int      @default(1)
  data        Json
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  project     Project  @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Cascade)
  versions    ProjectMarketingProfileVersion[]

  @@unique([workspaceId, projectId])
  @@unique([workspaceId, projectId, id])
  @@index([workspaceId, projectId])
}

model ProjectMarketingProfileVersion {
  profileId   String   @db.Uuid
  version     Int
  workspaceId String   @db.Uuid
  projectId   String   @db.Uuid
  data        Json
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  profile     ProjectMarketingProfile @relation(fields: [workspaceId, projectId, profileId], references: [workspaceId, projectId, id], onDelete: Cascade)

  @@id([profileId, version])
  @@index([workspaceId, projectId])
}

model ProjectMember {
  workspaceId String                    @db.Uuid
  projectId   String                    @db.Uuid
  userId      String
  role        String
  project     Project                   @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Cascade)
  user        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleRoles ProjectMemberModuleRole[]

  @@id([projectId, userId])
  @@index([workspaceId, userId])
}

/// A module's public API key for one project (WP4.2b); no secret.
model PublicClientKey {
  id             String    @id @default(uuid()) @db.Uuid
  workspaceId    String    @db.Uuid
  projectId      String    @db.Uuid
  moduleId       String
  publicKey      String    @unique
  allowedOrigins String[]  @default([])
  createdBy      String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt      DateTime? @db.Timestamptz(3)

  @@index([workspaceId, projectId])
}

/// A platform file (WP4.6): metadata of one encrypted object in object storage.
model File {
  id          String    @id @db.Uuid
  workspaceId String    @db.Uuid
  projectId   String    @db.Uuid
  moduleId    String
  key         String    @unique
  name        String?
  mime        String
  size        Int
  sha256      String
  encryption  String
  createdBy   String
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  deletedAt   DateTime? @db.Timestamptz(3)
  /// Not deletable before this time (retention lock).
  retainUntil DateTime? @db.Timestamptz(3)

  @@unique([projectId, id])
  @@index([workspaceId, projectId, moduleId])
}

/// The encrypted content of a platform file with FILES_BACKEND=database (WP4.6).
model FileBlob {
  key         String   @id
  workspaceId String   @db.Uuid
  projectId   String   @db.Uuid
  data        Bytes
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([workspaceId, projectId])
}

/// An in-app notice for one member (WP4.7); private to that member by RLS.
model Notification {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  projectId   String    @db.Uuid
  userId      String
  moduleId    String
  kind        String
  title       String
  body        String    @default("")
  link        String?
  readAt      DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([workspaceId, projectId, userId, createdAt])
}

/// A member's choice per notification kind (WP4.7).
model NotificationPreference {
  workspaceId String   @db.Uuid
  projectId   String   @db.Uuid
  userId      String
  kind        String
  inApp       Boolean
  email       Boolean
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@id([projectId, userId, kind])
}

/// Support (WP5.1): the tables of the support module. Same-project composite
/// foreign keys and the full-text trigger live in the migration's SQL.
model SupportInbox {
  id                    String    @id @db.Uuid
  workspaceId           String    @db.Uuid
  projectId             String    @db.Uuid
  name                  String
  channels              String[]
  emailAddress          String?
  /// The e-mail connection (`connectors` entity) the inbox answers from;
  /// same-project foreign key and one live inbox per connection in SQL.
  emailConnectionId     String?   @db.Uuid
  allowedOrigins        String[]  @default([])
  widgetSecretEnc       String?
  publicClientKeyId     String?   @db.Uuid
  defaultCategory       String?
  assignmentPolicy      String    @default("unassigned")
  defaultAssigneeUserId String?
  language              String    @default("en")
  aiMode                String    @default("off")
  rules                 Json      @default("{}")
  version               Int       @default(1)
  createdBy             String
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  archivedAt            DateTime? @db.Timestamptz(3)

  @@unique([projectId, id])
  @@index([workspaceId, projectId])
}

/// The last ticket number per project; numbers are never reused.
model SupportTicketCounter {
  projectId   String @id @db.Uuid
  workspaceId String @db.Uuid
  lastNumber  Int    @default(0)
}

model SupportContact {
  id           String    @id @db.Uuid
  workspaceId  String    @db.Uuid
  projectId    String    @db.Uuid
  name         String?
  email        String?
  claimedEmail String?
  locale       String?
  notes        String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  deletedAt    DateTime? @db.Timestamptz(3)

  @@unique([projectId, id])
}

model SupportContactIdentity {
  id             String   @id @db.Uuid
  workspaceId    String   @db.Uuid
  projectId      String   @db.Uuid
  contactId      String   @db.Uuid
  inboxId        String   @db.Uuid
  channel        String
  externalUserId String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@unique([projectId, id])
  @@unique([projectId, inboxId, channel, externalUserId], map: "SupportContactIdentity_external_key")
}

model SupportTicket {
  id                    String    @id @db.Uuid
  workspaceId           String    @db.Uuid
  projectId             String    @db.Uuid
  number                Int
  inboxId               String    @db.Uuid
  contactId             String    @db.Uuid
  subject               String
  status                String    @default("new")
  priority              String    @default("normal")
  category              String?
  tags                  String[]  @default([])
  assigneeUserId        String?
  channel               String
  firstResponseDueAt    DateTime? @db.Timestamptz(3)
  resolutionDueAt       DateTime? @db.Timestamptz(3)
  firstRespondedAt      DateTime? @db.Timestamptz(3)
  resolvedAt            DateTime? @db.Timestamptz(3)
  closedAt              DateTime? @db.Timestamptz(3)
  aiState               String    @default("none")
  lastCustomerMessageAt DateTime? @db.Timestamptz(3)
  mergedIntoTicketId    String?   @db.Uuid
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  @@unique([projectId, id])
  @@unique([projectId, number])
  @@index([projectId, status, assigneeUserId])
  @@index([projectId, inboxId, status])
  @@index([projectId, contactId])
  @@index([projectId, firstResponseDueAt])
  @@index([projectId, resolutionDueAt])
}

model SupportMessage {
  id                String                   @id @db.Uuid
  workspaceId       String                   @db.Uuid
  projectId         String                   @db.Uuid
  ticketId          String                   @db.Uuid
  kind              String
  authorContactId   String?                  @db.Uuid
  authorUserId      String?
  agentRunId        String?                  @db.Uuid
  bodyText          String
  bodyHtml          String?
  channel           String
  externalId        String?
  deliveryState     String?
  visibleToCustomer Boolean
  searchVector      Unsupported("tsvector")?
  createdAt         DateTime                 @default(now()) @db.Timestamptz(3)

  @@unique([projectId, id])
  @@unique([projectId, channel, externalId], map: "SupportMessage_external_key")
  @@index([projectId, ticketId, createdAt])
}

model SupportAttachment {
  id          String   @id @db.Uuid
  workspaceId String   @db.Uuid
  projectId   String   @db.Uuid
  messageId   String   @db.Uuid
  fileId      String   @db.Uuid
  name        String
  mime        String
  size        Int
  scanState   String   @default("not_scanned")
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@unique([projectId, id])
  @@index([projectId, messageId])
}

model SupportTicketEvent {
  id          String   @id @db.Uuid
  workspaceId String   @db.Uuid
  projectId   String   @db.Uuid
  ticketId    String   @db.Uuid
  type        String
  actorKind   String
  actorId     String?
  before      Json     @default("{}")
  after       Json     @default("{}")
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@unique([projectId, id])
  @@index([projectId, ticketId, createdAt])
}

// Finance module (spec 2026-10-23 §4). Relations live in SQL as composite
// same-project foreign keys; the models declare none, like Support. Amounts
// are BigInt micros, rates Decimal(24,12). The journal is append-only.

model FinanceAccount {
  id             String    @id @db.Uuid
  workspaceId    String    @db.Uuid
  projectId      String    @db.Uuid
  code           String
  name           String
  type           String
  role           String?
  paymentAccount Boolean   @default(false)
  currency       String?
  externalCode   String?
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  archivedAt     DateTime? @db.Timestamptz(3)

  @@unique([projectId, id])
  @@unique([projectId, code])
}

model FinanceCategory {
  id          String    @id @db.Uuid
  workspaceId String    @db.Uuid
  projectId   String    @db.Uuid
  name        String
  kind        String
  parentId    String?   @db.Uuid
  accountId   String    @db.Uuid
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  archivedAt  DateTime? @db.Timestamptz(3)

  @@unique([projectId, id])
}

model FinanceCostCenter {
  id             String    @id @db.Uuid
  workspaceId    String    @db.Uuid
  projectId      String    @db.Uuid
  code           String
  name           String
  orbitProjectId String?   @db.Uuid
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  archivedAt     DateTime? @db.Timestamptz(3)

  @@unique([projectId, id])
  @@unique([projectId, code])
}

model FinanceCounterparty {
  id                String   @id @db.Uuid
  workspaceId       String   @db.Uuid
  projectId         String   @db.Uuid
  name              String
  normalizedName    String
  taxId             String?
  emailDomains      String[] @default([])
  defaultCategoryId String?  @db.Uuid
  defaultAllocation Json?
  version           Int      @default(1)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@unique([projectId, id])
  @@index([projectId, normalizedName])
}

model FinanceMailbox {
  id                String   @id @db.Uuid
  workspaceId       String   @db.Uuid
  projectId         String   @db.Uuid
  /// The `connectors` entity with provider "email"; one binding per connection.
  emailConnectionId String   @db.Uuid
  archiveFolder     String   @default("Orbit/Processed")
  active            Boolean  @default(true)
  version           Int      @default(1)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@unique([projectId, id])
  @@unique([projectId, emailConnectionId])
}

/// One original. One live row per (projectId, sha256) by a partial unique
/// index in SQL; rejected and duplicate rows keep the hash.
model FinanceDocument {
  id             String   @id @db.Uuid
  workspaceId    String   @db.Uuid
  projectId      String   @db.Uuid
  fileId         String   @db.Uuid
  sha256         String
  source         String
  mailboxId      String?  @db.Uuid
  inboundEmailId String?  @db.Uuid
  messageId      String?
  emailFileId    String?  @db.Uuid
  originalName   String?
  mimeType       String
  status         String   @default("received")
  docType        String   @default("unknown")
  extraction     Json?
  confidence     Float?
  flags          String[] @default([])
  duplicateOfId  String?  @db.Uuid
  agentRunId     String?  @db.Uuid
  /// Why a person rejected the document; never copied into the audit trail.
  rejectionReason String?
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@unique([projectId, id])
  @@index([projectId, status])
  @@index([projectId, messageId])
}

model FinanceDocumentRevision {
  id          String   @id @db.Uuid
  workspaceId String   @db.Uuid
  projectId   String   @db.Uuid
  documentId  String   @db.Uuid
  version     Int
  actorUserId String?
  changes     Json
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@unique([projectId, id])
  @@unique([projectId, documentId, version])
}

/// The next journal number per project and year.
model FinanceEntryCounter {
  workspaceId String @db.Uuid
  projectId   String @db.Uuid
  year        Int
  next        Int    @default(1)

  @@id([projectId, year])
}

/// A posted entry. Database triggers allow only setting reversedById once
/// (to its reversal), accept lines only in the posting transaction and check
/// at commit that its lines balance in the base currency.
model FinanceJournalEntry {
  id           String   @id @db.Uuid
  workspaceId  String   @db.Uuid
  projectId    String   @db.Uuid
  number       String
  entryDate    DateTime @db.Date
  kind         String
  status       String   @default("posted")
  memo         String?
  documentId   String?  @db.Uuid
  sourceType   String?
  sourceId     String?  @db.Uuid
  reversalOfId String?  @db.Uuid
  reversedById String?  @db.Uuid
  postedBy     String
  postedAt     DateTime @default(now()) @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@unique([projectId, id])
  @@unique([projectId, number])
  @@unique([projectId, reversalOfId])
  @@index([projectId, entryDate])
  @@index([projectId, documentId])
}

/// A posted line; never updated (database trigger).
model FinanceJournalLine {
  id               String   @id @db.Uuid
  workspaceId      String   @db.Uuid
  projectId        String   @db.Uuid
  entryId          String   @db.Uuid
  accountId        String   @db.Uuid
  side             String
  currency         String
  amountMicros     BigInt
  fxRate           Decimal  @db.Decimal(24, 12)
  rateDate         DateTime @db.Date
  rateSource       String
  baseAmountMicros BigInt
  categoryId       String?  @db.Uuid
