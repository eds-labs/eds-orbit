// OAuth 2.1 authorization server for MCP clients (Track M, WP-M1). These are
// Better Auth's own models (jwt + oauth-provider + cimd plugins, version 1.7.10),
// so field names stay verbatim; the drift test in
// apps/api/tests/mcp-oauth-schema.integration.test.ts compares them with
// getAuthTables(). They belong to the auth set: orbit_auth only, no RLS, no
// orbit_app access. The Prisma adapter reaches them by the delegate name, which
// is the model name with a lower-case first letter (prisma.oauthClient).

/// Signing keys of the jwt plugin; the private key is stored encrypted.
model Jwks {
  id         String    @id
  publicKey  String
  privateKey String
  createdAt  DateTime  @db.Timestamptz(3)
  expiresAt  DateTime? @db.Timestamptz(3)
  alg        String?
  crv        String?

  @@map("jwks")
}

model OauthClient {
  id                               String                @id
  clientId                         String                @unique
  clientSecret                     String?
  clientDiscoveryId                String?
  disabled                         Boolean?              @default(false)
  skipConsent                      Boolean?
  enableEndSession                 Boolean?
  subjectType                      String?
  scopes                           String[]
  clientCredentialsScopes          String[]
  userId                           String?
  user                             User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt                        DateTime?             @db.Timestamptz(3)
  updatedAt                        DateTime?             @db.Timestamptz(3)
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         String[]
  tos                              String?
  policy                           String?
  softwareId                       String?
  softwareVersion                  String?
  softwareStatement                String?
  redirectUris                     String[]
  postLogoutRedirectUris           String[]
  backchannelLogoutUri             String?
  backchannelLogoutSessionRequired Boolean?
  tokenEndpointAuthMethod          String?
  applicationType                  String?
  jwks                             String?
  jwksUri                          String?
  grantTypes                       String[]
  responseTypes                    String[]
  requirePKCE                      Boolean?
  dpopBoundAccessTokens            Boolean?              @default(false)
  referenceId                      String?
  metadata                         Json?
  accessTokens                     OauthAccessToken[]
  refreshTokens                    OauthRefreshToken[]
  consents                         OauthConsent[]
  resources                        OauthClientResource[]

  @@index([userId])
  @@map("oauthClient")
}

model OauthRefreshToken {
  id                      String             @id
  token                   String             @unique
  clientId                String
  client                  OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]
  requestedUserInfoClaims String[]
  expiresAt               DateTime           @db.Timestamptz(3)
  createdAt               DateTime           @db.Timestamptz(3)
  revoked                 DateTime?          @db.Timestamptz(3)
  rotatedAt               DateTime?          @db.Timestamptz(3)
  rotationReplayResponse  String?
  rotationReplayExpiresAt DateTime?          @db.Timestamptz(3)
  authTime                DateTime?          @db.Timestamptz(3)
  confirmation            Json?
  scopes                  String[]
  accessTokens            OauthAccessToken[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@map("oauthRefreshToken")
}

model OauthAccessToken {
  id                      String             @id
  token                   String             @unique
  clientId                String
  client                  OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String?
  user                    User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]
  requestedUserInfoClaims String[]
  refreshId               String?
  refresh                 OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: Cascade)
  expiresAt               DateTime           @db.Timestamptz(3)
  createdAt               DateTime           @db.Timestamptz(3)
  revoked                 DateTime?          @db.Timestamptz(3)
  confirmation            Json?
  scopes                  String[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@index([refreshId])
  @@map("oauthAccessToken")
}

/// A user's consent for one client; `referenceId` is the workspace that was granted.
model OauthConsent {
  id                      String      @id
  clientId                String
  client                  OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId                  String?
  user                    User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  resources               String[]
  requestedUserInfoClaims String[]
  scopes                  String[]
  createdAt               DateTime    @db.Timestamptz(3)
  updatedAt               DateTime    @db.Timestamptz(3)

  @@index([clientId])
  @@index([userId])
  @@map("oauthConsent")
}

/// Used private_key_jwt assertions (jti is the id); rows only need to live until expiresAt.
model OauthClientAssertion {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(3)

  @@map("oauthClientAssertion")
}

model OauthResource {
  id                            String                @id
  identifier                    String                @unique
  name                          String
  accessTokenTtl                Int?
  refreshTokenTtl               Int?
  signingAlgorithm              String?
  signingKeyId                  String?
  allowedScopes                 String[]
  customClaims                  Json?
  dpopBoundAccessTokensRequired Boolean?              @default(false)
  disabled                      Boolean?              @default(false)
  createdAt                     DateTime?             @db.Timestamptz(3)
  updatedAt                     DateTime?             @db.Timestamptz(3)
  policyVersion                 Int?                  @default(1)
  metadata                      Json?
  clients                       OauthClientResource[]

  @@map("oauthResource")
}

model OauthClientResource {
  id         String        @id
  clientId   String
  client     OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resourceId String
  resource   OauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)
  metadata   Json?
  createdAt  DateTime?     @db.Timestamptz(3)

  @@unique([clientId, resourceId])
  @@index([clientId])
  @@index([resourceId])
  @@map("oauthClientResource")
}

/// What a user let an MCP client do in one workspace. Grants only narrow what the
/// user may do in the UI (docs 09 section 4.2); they never add rights.
/// `status` is pending | active | revoked. A partial unique index in the migration
/// (SQL only, Prisma cannot express it) allows one active grant per user, client
/// and workspace. `modules` empty means no module restriction. `clientId` and
/// `sessionId` are plain text: clients can be pruned and sessions rotate, while
/// grants and their events are kept as the record of what was allowed.
model McpGrant {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId           String
  workspaceId        String    @db.Uuid
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectIds         String[]  @db.Uuid
  allCurrentProjects Boolean   @default(false)
  scopes             String[]
  modules            String[]
  /// pending, active or revoked (CHECK constraint in the migration).
  status             String
  sessionId          String?
  /// Fingerprint of the authorization request a selection was made for (WP-M5).
  requestHash        String?
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  activatedAt        DateTime? @db.Timestamptz(3)
  expiresAt          DateTime? @db.Timestamptz(3)
  revokedAt          DateTime? @db.Timestamptz(3)
  revokedBy          String?
  lastUsedAt         DateTime? @db.Timestamptz(3)

  @@index([userId, clientId, workspaceId, status])
  @@index([sessionId])
}

/// Append-only record of grant changes. No foreign keys: it outlives grants,
/// users and workspaces.
model McpGrantEvent {
  id          String   @id @default(uuid()) @db.Uuid
  grantId     String?  @db.Uuid
  userId      String
  clientId    String
  workspaceId String?  @db.Uuid
  action      String
  detail      Json     @default("{}")
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([workspaceId, createdAt])
}

/// An invitation to an organization (ADR 0013). Only the sha256 hash of the
/// token is stored; one open invitation per address and organization.
model Invitation {
  id             String                   @id @default(uuid()) @db.Uuid
  tokenHash      String                   @unique
  email          String
  workspaceId    String                   @db.Uuid
  /// 'owner' or 'viewer' (organization member).
  workspaceRole  String
  invitedBy      String
  locale         String?
  expiresAt      DateTime                 @db.Timestamptz(3)
  acceptedAt     DateTime?                @db.Timestamptz(3)
  acceptedUserId String?
  revokedAt      DateTime?                @db.Timestamptz(3)
  createdAt      DateTime                 @default(now()) @db.Timestamptz(3)
  workspace      Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects       InvitationProjectGrant[]

  @@index([workspaceId, email])
  @@index([email])
}

/// A project role (and module roles) an invitation grants on acceptance.
model InvitationProjectGrant {
  invitationId String     @db.Uuid
  workspaceId  String     @db.Uuid
  projectId    String     @db.Uuid
  role         String
  moduleRoles  Json       @default("{}")
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  project      Project    @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Cascade)

  @@id([invitationId, projectId])
  @@index([workspaceId, projectId])
}

/// Append-only, project-independent audit of administrative actions.
/// Identifiers and codes only, never addresses, tokens or free text.
model SystemAuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  actorId     String
  action      String
  targetType  String
  targetId    String
  workspaceId String?  @db.Uuid
  projectId   String?  @db.Uuid
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
  @@index([targetId, createdAt])
  @@index([actorId, createdAt])
}

/// An external connection with its owner scope (ADR 0014): system,
/// workspace (organization) or project. Secrets live in ConnectionSecret;
/// using it needs an active ConnectionGrant for the consuming project.
model Connection {
  id                  String             @id @default(uuid()) @db.Uuid
  provider            String
  scope               String
  workspaceId         String?            @db.Uuid
  projectId           String?            @db.Uuid
  label               String
  config              Json               @default("{}")
  status              String             @default("configured")
  health              Json               @default("{}")
  monthlyBudgetMicros BigInt?
  version             Int                @default(1)
  createdBy           String
  legacyRef           Json?
  disabledAt          DateTime?          @db.Timestamptz(3)
  revokedAt           DateTime?          @db.Timestamptz(3)
  createdAt           DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime           @default(now()) @updatedAt @db.Timestamptz(3)
  workspace           Workspace?         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project             Project?           @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Cascade, map: "Connection_project_fkey")
  secrets             ConnectionSecret[]
  grants              ConnectionGrant[]
  counters            SpendCounter[]
  workflows           WorkflowBinding[]

  @@index([workspaceId])
  @@index([projectId])
}

/// A versioned, encrypted secret of a connection; one active at a time.
model ConnectionSecret {
  id           String     @id @default(uuid()) @db.Uuid
  connectionId String     @db.Uuid
  version      Int
  keyId        String
  ciphertext   String
  state        String
  createdBy    String
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  retiredAt    DateTime?  @db.Timestamptz(3)
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, version])
}

/// Permission to use a connection: an organization grant (projectId null,
/// a parent) or a project grant (usable), limited by purposes and modules.
model ConnectionGrant {
  id                  String            @id @default(uuid()) @db.Uuid
  connectionId        String            @db.Uuid
  workspaceId         String            @db.Uuid
  projectId           String?           @db.Uuid
  userId              String?
  parentGrantId       String?           @db.Uuid
  purposes            String[]          @default([])
  modules             String[]          @default([])
  settings            Json              @default("{}")
  monthlyBudgetMicros BigInt?
  createdBy           String
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)
  lastUsedAt          DateTime?         @db.Timestamptz(3)
  revokedAt           DateTime?         @db.Timestamptz(3)
  revokedBy           String?
  connection          Connection        @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  workspace           Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project             Project?          @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Cascade, map: "ConnectionGrant_project_fkey")
  parent              ConnectionGrant?  @relation("GrantParent", fields: [parentGrantId], references: [id], onDelete: Cascade)
  children            ConnectionGrant[] @relation("GrantParent")

  @@index([connectionId])
  @@index([workspaceId, projectId])
  @@index([parentGrantId])
}

/// Monthly spend per grant or connection, locked while reserving, so
/// organization and system budgets hold across projects.
model SpendCounter {
  scopeKey       String
  periodStart    DateTime   @db.Timestamptz(3)
  connectionId   String     @db.Uuid
  workspaceId    String?    @db.Uuid
  reservedMicros BigInt     @default(0)
  settledMicros  BigInt     @default(0)
  connection     Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@id([scopeKey, periodStart])
}

/// AI models, routes, rate cards and defaults for the system or one
/// organization; a project's openai_configuration overrides them.
model AiProfile {
  id          String     @id @default(uuid()) @db.Uuid
  scope       String
  workspaceId String?    @unique @db.Uuid
  version     Int        @default(1)
  data        Json       @default("{}")
  updatedBy   String
  updatedAt   DateTime   @default(now()) @db.Timestamptz(3)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// A price override or on/off switch of one catalog model, for the system or
/// one organization (plans/ai-central-management.md, phase A).
model AiModelPrice {
  id             String     @id @default(uuid()) @db.Uuid
  scope          String
  workspaceId    String?    @db.Uuid
  modelId        String
  active         Boolean    @default(true)
  rate           Json?
  perImageMicros Int?
  verifiedAt     DateTime?  @db.Timestamptz(3)
  version        Int        @default(1)
  updatedBy      String
  updatedAt      DateTime   @default(now()) @db.Timestamptz(3)
  workspace      Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// An organization's AI budget (plans/ai-central-management.md, phase C):
/// one monthly amount and caps per provider, set by its owners.
model OrganizationAiBudget {
  id            String    @id @default(uuid()) @db.Uuid
  workspaceId   String    @unique @db.Uuid
  monthlyMicros BigInt?
  providerCaps  Json      @default("{}")
  credits       Json      @default("{}")
  version       Int       @default(1)
  updatedBy     String
  updatedAt     DateTime  @default(now()) @db.Timestamptz(3)
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// An organization's AI spend of one UTC month, in total or per provider.
model OrganizationSpendCounter {
  workspaceId    String    @db.Uuid
  scopeKey       String
  periodStart    DateTime  @db.Timestamptz(3)
  reservedMicros BigInt    @default(0)
  settledMicros  BigInt    @default(0)
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, scopeKey, periodStart])
}

/// A consumer project's permission to search an organization library.
model KnowledgeShare {
  id                String    @id @default(uuid()) @db.Uuid
  workspaceId       String    @db.Uuid
  libraryProjectId  String    @db.Uuid
  consumerProjectId String    @db.Uuid
  sourceIds         String[]  @default([]) @db.Uuid
  modules           String[]  @default([])
  generation        Int       @default(1)
  createdBy         String
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  revokedAt         DateTime? @db.Timestamptz(3)
  library           Project   @relation("KnowledgeShareLibrary", fields: [workspaceId, libraryProjectId], references: [workspaceId, id], onDelete: Cascade, map: "KnowledgeShare_library_fkey")
  consumer          Project   @relation("KnowledgeShareConsumer", fields: [workspaceId, consumerProjectId], references: [workspaceId, id], onDelete: Cascade, map: "KnowledgeShare_consumer_fkey")

  @@index([workspaceId, consumerProjectId], map: "KnowledgeShare_consumer_idx")
  @@index([workspaceId, libraryProjectId], map: "KnowledgeShare_library_idx")
}

/// A workflow of an automation connection (such as n8n) bound to a
/// product-neutral Orbit contract (ADR 0014, WP3.7).
model WorkflowBinding {
  id           String     @id @default(uuid()) @db.Uuid
  connectionId String     @db.Uuid
  contract     String
  workflowRef  String
  label        String
  createdBy    String
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  revokedAt    DateTime?  @db.Timestamptz(3)
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId])
}

// Project management module (ADR 0016, plan §3.4). Relations live in SQL as
// composite same-project foreign keys; the models declare none, like Support
// and Finance. Triggers keep milestones inside their initiative and subtasks
// one level deep.

model WorkInitiative {
  id          String    @id @db.Uuid
  workspaceId String    @db.Uuid
  projectId   String    @db.Uuid
  key         String
  title       String
  description String?
  status      String    @default("planned")
  health      String    @default("unknown")
  ownerUserId String?
  startDate   DateTime? @db.Date
  targetDate  DateTime? @db.Date
  version     Int       @default(1)
  createdBy   String
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  archivedAt  DateTime? @db.Timestamptz(3)

  @@unique([projectId, id])
  @@unique([projectId, key])
}

model WorkMilestone {
  id           String    @id @db.Uuid
  workspaceId  String    @db.Uuid
  projectId    String    @db.Uuid
  initiativeId String    @db.Uuid
  title        String
  description  String?
  dueDate      DateTime? @db.Date
  status       String    @default("open")
  sortOrder    Int       @default(0)
  version      Int       @default(1)
  createdBy    String
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  archivedAt   DateTime? @db.Timestamptz(3)

  @@unique([projectId, id])
  @@index([projectId, initiativeId, dueDate])
}

/// The last task number per project; numbers are never reused.
model WorkTaskCounter {
  projectId   String @id @db.Uuid
  workspaceId String @db.Uuid
  lastNumber  Int    @default(0)
}

model WorkTask {
  id               String                   @id @db.Uuid
  workspaceId      String                   @db.Uuid
  projectId        String                   @db.Uuid
  number           Int
  initiativeId     String?                  @db.Uuid
  milestoneId      String?                  @db.Uuid
  parentTaskId     String?                  @db.Uuid
  title            String
  description      String?
  status           String
  statusCategory   String
  priority         String                   @default("none")
  category         String?
  labels           String[]                 @default([])
  assigneeUserId   String?
  assigneeAgentKey String?
  teamKey          String?
  startDate        DateTime?                @db.Date
  dueDate          DateTime?                @db.Date
  completedAt      DateTime?                @db.Timestamptz(3)
  estimate         Int?
  rank             String
  source           String                   @default("manual")
  searchVector     Unsupported("tsvector")?
  version          Int                      @default(1)
  createdBy        String
  createdAt        DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                 @default(now()) @updatedAt @db.Timestamptz(3)
  archivedAt       DateTime?                @db.Timestamptz(3)

  @@unique([projectId, id])
  @@unique([projectId, number])
  @@index([projectId, milestoneId])
  @@index([projectId, parentTaskId])
}

model WorkChecklistItem {
  id          String    @id @db.Uuid
  workspaceId String    @db.Uuid
  projectId   String    @db.Uuid
  taskId      String    @db.Uuid
  text        String
  done        Boolean   @default(false)
  doneBy      String?
  doneAt      DateTime? @db.Timestamptz(3)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([projectId, id])
  @@index([projectId, taskId, sortOrder])
}

/// `taskId` waits for `dependsOnTaskId` (finish to start).
model WorkTaskDependency {
  id              String   @id @db.Uuid
  workspaceId     String   @db.Uuid
  projectId       String   @db.Uuid
  taskId          String   @db.Uuid
  dependsOnTaskId String   @db.Uuid
  kind            String   @default("finish_to_start")
  createdBy       String
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  @@unique([projectId, id])
  @@unique([projectId, taskId, dependsOnTaskId], map: "WorkTaskDependency_pair_key")
  @@index([projectId, dependsOnTaskId])
}

model WorkComment {
  id           String    @id @db.Uuid
  workspaceId  String    @db.Uuid
  projectId    String    @db.Uuid
  taskId       String    @db.Uuid
  authorKind   String
  authorUserId String?
  agentRunId   String?   @db.Uuid
  bodyText     String
  mentions     String[]  @default([])
  editedAt     DateTime? @db.Timestamptz(3)
  deletedAt    DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([projectId, id])
  @@index([projectId, taskId, createdAt])
}

model WorkAttachment {
  id          String   @id @db.Uuid
  workspaceId String   @db.Uuid
  projectId   String   @db.Uuid
  taskId      String   @db.Uuid
  fileId      String   @db.Uuid
  name        String
  mime        String
  size        Int
  addedBy     String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@unique([projectId, id])
  @@unique([projectId, taskId, fileId], map: "WorkAttachment_task_file_key")
  @@index([projectId, taskId])
}

model WorkTaskWatcher {
  workspaceId String   @db.Uuid
  projectId   String   @db.Uuid
  taskId      String   @db.Uuid
  userId      String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@id([projectId, taskId, userId])
}

/// History of a task, initiative or milestone (exactly one is set): ids and
/// field names only.
model WorkEvent {
  id           String   @id @db.Uuid
  workspaceId  String   @db.Uuid
  projectId    String   @db.Uuid
  taskId       String?  @db.Uuid
  initiativeId String?  @db.Uuid
  milestoneId  String?  @db.Uuid
  type         String
  actorKind    String
  actorId      String?
  before       Json     @default("{}")
  after        Json     @default("{}")
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@unique([projectId, id])
  @@index([projectId, taskId, createdAt])
  @@index([projectId, initiativeId, createdAt])
  @@index([projectId, milestoneId, createdAt])
}

// AI project manager (ADR 0017, plan §3). Relations live in SQL like the
// other work tables; partial unique indexes (one open finding per
// fingerprint, one active coding run per task) are SQL only.

model WorkPmState {
  id             String    @id @db.Uuid
  workspaceId    String    @db.Uuid
  projectId      String    @db.Uuid
  initiativeId   String    @db.Uuid
  enabled        Boolean   @default(false)
  settings       Json      @default("{}")
  lastScanAt     DateTime? @db.Timestamptz(3)
  lastScanHash   String?
  lastReportAt   DateTime? @db.Timestamptz(3)
  lastReportHash String?
  lastAnalysisAt DateTime? @db.Timestamptz(3)
  version        Int       @default(1)
  updatedBy      String
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  @@unique([projectId, id])
  @@unique([projectId, initiativeId])
}

model WorkPlanProposal {
  id             String    @id @db.Uuid
  workspaceId    String    @db.Uuid
  projectId      String    @db.Uuid
  initiativeId   String?   @db.Uuid
  kind           String
  status         String
  requestText    String?
  requestedBy    String
  requestedVia   String
  idempotencyKey String?
  revision       Int       @default(1)
  supersedesId   String?   @db.Uuid
  plan           Json?
  validation     Json      @default("{}")
  planHash       String?
  agentRunId     String?   @db.Uuid
  actionRequestId String?  @db.Uuid
  appliedAt      DateTime? @db.Timestamptz(3)
  appliedTaskIds String[]  @default([]) @db.Uuid
  costMicros     BigInt    @default(0)
  errorCode      String?
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  @@unique([projectId, id])
  @@unique([projectId, idempotencyKey])
  @@index([projectId, initiativeId, status])
  @@index([projectId, requestedBy, createdAt])
}

model WorkPmFinding {
  id             String    @id @db.Uuid
  workspaceId    String    @db.Uuid
  projectId      String    @db.Uuid
  initiativeId   String    @db.Uuid
  rule           String
  severity       String
  fingerprint    String
  taskIds        String[]  @default([]) @db.Uuid
  milestoneId    String?   @db.Uuid
  status         String    @default("open")
  dismissedBy    String?
  dismissedUntil DateTime? @db.Timestamptz(3)
  firstSeenAt    DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt     DateTime  @default(now()) @db.Timestamptz(3)
  resolvedAt     DateTime? @db.Timestamptz(3)
  data           Json      @default("{}")

  @@unique([projectId, id])
  @@index([projectId, initiativeId, status, severity])
}

model WorkPmReport {
  id           String   @id @db.Uuid
  workspaceId  String   @db.Uuid
  projectId    String   @db.Uuid
  initiativeId String   @db.Uuid
  kind         String
  stateHash    String
  body         String
  data         Json     @default("{}")
  findingIds   String[] @default([]) @db.Uuid
  agentRunId   String?  @db.Uuid
  costMicros   BigInt   @default(0)
  requestedBy  String?
  publishedTo  String[] @default([])
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@unique([projectId, id])
  @@index([projectId, initiativeId, createdAt])
}

model WorkHandoff {
  id              String   @id @db.Uuid
  workspaceId     String   @db.Uuid
  projectId       String   @db.Uuid
  taskId          String   @db.Uuid
  targetKey       String
  status          String   @default("awaiting_approval")
  input           Json
  inputHash       String
  targetType      String?
  targetId        String?  @db.Uuid
  actionRequestId String?  @db.Uuid
  ceilingMicros   BigInt   @default(0)
  costMicros      BigInt   @default(0)
  result          Json     @default("{}")
  errorCode       String?
  createdBy       String
  version         Int      @default(1)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@unique([projectId, id])
  @@index([projectId, targetType, targetId])
  @@index([projectId, taskId])
}

model WorkCodingRun {
  id                   String    @id @db.Uuid
  workspaceId          String    @db.Uuid
  projectId            String    @db.Uuid
  taskId               String    @db.Uuid
  repositoryKey        String
  provider             String
  status               String    @default("draft")
  briefRevision        Int       @default(1)
  brief                Json
  briefHash            String
  sanitization         Json      @default("{}")
  personalDataReviewed Boolean   @default(false)
  ceilingMicros        BigInt    @default(0)
  reportedCostMicros   BigInt?
  actionRequestId      String?   @db.Uuid
  automationRunId      String?   @db.Uuid
  externalRef          String?
  branch               String?
  prUrl                String?
  prNumber             Int?
  commitSha            String?
  tests                Json?
  summary              String?
  errorCode            String?
  dispatchedAt         DateTime? @db.Timestamptz(3)
  startedAt            DateTime? @db.Timestamptz(3)
  finishedAt           DateTime? @db.Timestamptz(3)
  timeoutAt            DateTime? @db.Timestamptz(3)
  createdBy            String
  version              Int       @default(1)
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  @@unique([projectId, id])
  @@index([projectId, status, timeoutAt])
  @@index([projectId, taskId])
}
