generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String            @id
  name               String
  email              String            @unique
  emailVerified      Boolean           @default(false)
  image              String?
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(3)
  sessions           Session[]
  accounts           Account[]
  memberships        WorkspaceMember[]
  projectMemberships ProjectMember[]
  chatConversations ChatConversation[]
  oauthClients       OauthClient[]
  oauthAccessTokens  OauthAccessToken[]
  oauthRefreshTokens OauthRefreshToken[]
  oauthConsents      OauthConsent[]
  mcpGrants          McpGrant[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthAccessTokens  OauthAccessToken[]
  oauthRefreshTokens OauthRefreshToken[]

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

model Workspace {
  id        String            @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime          @default(now()) @db.Timestamptz(3)
  members   WorkspaceMember[]
  projects  Project[]
  mcpGrants McpGrant[]
}

model WorkspaceMember {
  workspaceId String    @db.Uuid
  userId      String
  role        String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
}

model Project {
  id               String              @id @default(uuid()) @db.Uuid
  workspaceId      String              @db.Uuid
  name             String
  timezone         String              @default("UTC")
  language         String              @default("en")
  mode             String              @default("observe")
  paused           Boolean             @default(false)
  generation       Int                 @default(1)
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)
  /// Earliest time the worker must process this project; maintained by triggers and the worker.
  workDueAt        DateTime            @default(now()) @db.Timestamptz(3)
  workspace        Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members          ProjectMember[]
  entities         Entity[]
  outbox           Outbox[]
  budgets          BudgetReservation[]
  audits           AuditEvent[]
  knowledgeIndexes KnowledgeIndex[]
  marketingProfile ProjectMarketingProfile?
  chatConversations ChatConversation[]
  agentRuns        AgentRun[]
  modules          ProjectModule[]

  @@unique([workspaceId, id])
  @@index([workDueAt])
}

/// Module activation per project (WP1.4). No row: the registry default applies.
model ProjectModule {
  id              String   @id @default(uuid()) @db.Uuid
  workspaceId     String   @db.Uuid
  projectId       String   @db.Uuid
  moduleId        String
  enabled         Boolean
  settings        Json     @default("{}")
  settingsVersion Int      @default(1)
  /// Module contract version when the row was last written.
  moduleVersion   String
  changedBy       String?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  project         Project  @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, projectId, moduleId])
}

model ChatConversation {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  projectId   String   @db.Uuid
  userId      String
  title       String   @default("New conversation")
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  project     Project  @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    ChatMessage[]
  runs        ChatRun[]
  proposals   ChatProposal[]

  @@unique([workspaceId, projectId, id])
  @@unique([workspaceId, projectId, id, userId])
  @@index([workspaceId, projectId, userId, updatedAt])
}

model ChatMessage {
  id             String           @id @default(uuid()) @db.Uuid
  workspaceId    String           @db.Uuid
  projectId      String           @db.Uuid
  userId         String
  conversationId String           @db.Uuid
  sequence       Int
  role           String
  text           String
  cards          Json             @default("[]")
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  conversation   ChatConversation @relation(fields: [workspaceId, projectId, conversationId, userId], references: [workspaceId, projectId, id, userId], onDelete: Cascade)

  @@unique([conversationId, sequence])
  @@index([workspaceId, projectId, userId, conversationId])
}

model ChatRun {
  id              String           @id @default(uuid()) @db.Uuid
  workspaceId     String           @db.Uuid
  projectId       String           @db.Uuid
  userId          String
  conversationId  String           @db.Uuid
  clientRequestId String
  jobId           String?          @db.Uuid
  status          String           @default("queued")
  partialText     String           @default("")
  sequence        Int              @default(0)
  errorCode       String?
  reservationId   String?          @db.Uuid
  transmittedAt   DateTime?        @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  conversation    ChatConversation @relation(fields: [workspaceId, projectId, conversationId, userId], references: [workspaceId, projectId, id, userId], onDelete: Cascade)

  @@unique([conversationId, clientRequestId])
  @@index([workspaceId, projectId, userId, conversationId])
}

model ChatProposal {
  id             String           @id @default(uuid()) @db.Uuid
  workspaceId    String           @db.Uuid
  projectId      String           @db.Uuid
  userId         String
  conversationId String           @db.Uuid
  groupId        String           @db.Uuid
  version        Int
  payload        Json
  payloadHash    String
  status         String           @default("proposed")
  confirmationId String?
  missionId      String?          @db.Uuid
  jobId          String?          @db.Uuid
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  confirmedAt    DateTime?        @db.Timestamptz(3)
  conversation   ChatConversation @relation(fields: [workspaceId, projectId, conversationId, userId], references: [workspaceId, projectId, id, userId], onDelete: Cascade)

  @@unique([groupId, version])
  @@unique([conversationId, confirmationId])
  @@index([workspaceId, projectId, userId, conversationId])
}

model ProjectMarketingProfile {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  projectId   String   @unique @db.Uuid
  version     Int      @default(1)
  data        Json
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  project     Project  @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Cascade)
  versions    ProjectMarketingProfileVersion[]

  @@unique([workspaceId, projectId])
  @@unique([workspaceId, projectId, id])
  @@index([workspaceId, projectId])
}

model ProjectMarketingProfileVersion {
  profileId   String   @db.Uuid
  version     Int
  workspaceId String   @db.Uuid
  projectId   String   @db.Uuid
  data        Json
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  profile     ProjectMarketingProfile @relation(fields: [workspaceId, projectId, profileId], references: [workspaceId, projectId, id], onDelete: Cascade)

  @@id([profileId, version])
  @@index([workspaceId, projectId])
}

model ProjectMember {
  workspaceId String  @db.Uuid
  projectId   String  @db.Uuid
  userId      String
  role        String
  project     Project @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Cascade)
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([workspaceId, userId])
}

model Entity {
  id          String              @id @default(uuid()) @db.Uuid
  workspaceId String              @db.Uuid
  projectId   String              @db.Uuid
  kind        String
  version     Int                 @default(1)
  data        Json
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(3)
  project     Project             @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Cascade)
  versions    EntityVersion[]
  documents   KnowledgeDocument[]

  @@unique([projectId, id])
  @@unique([workspaceId, projectId, id])
  @@index([workspaceId, projectId, kind])
}

model EntityVersion {
  workspaceId String   @db.Uuid
  projectId   String   @db.Uuid
  entityId    String   @db.Uuid
  version     Int
  data        Json
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  entity      Entity   @relation(fields: [workspaceId, projectId, entityId], references: [workspaceId, projectId, id], onDelete: Cascade)

  @@id([entityId, version])
  @@index([workspaceId, projectId])
}

model Outbox {
  id           String    @id @default(uuid()) @db.Uuid
  workspaceId  String    @db.Uuid
  projectId    String    @db.Uuid
  topic        String
  entityId     String    @db.Uuid
  payload      Json
  availableAt  DateTime  @default(now()) @db.Timestamptz(3)
  dispatchedAt DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  project      Project   @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Cascade)

  @@index([workspaceId, projectId, dispatchedAt, availableAt])
}

model BudgetReservation {
  id            String   @id @default(uuid()) @db.Uuid
  workspaceId   String   @db.Uuid
  projectId     String   @db.Uuid
  key           String   @unique
  amountMicros  BigInt
  category      String
  state         String
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  settledMicros BigInt?
  agentRunId    String?  @db.Uuid
  taskClass     String?
  model         String?
  missionId     String?  @db.Uuid
  project       Project  @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Cascade)

  @@index([workspaceId, projectId, createdAt])
  @@index([workspaceId, projectId, agentRunId])
}

model AgentRun {
  id          String      @id @db.Uuid
  workspaceId String      @db.Uuid
  projectId   String      @db.Uuid
  kind        String
  agentName   String
  taskClass   String
  subjectType String?
  subjectId   String?
  missionId   String?     @db.Uuid
  routeVersion Int?
  status      String      @default("running")
  errorCode   String?
  startedAt   DateTime    @default(now()) @db.Timestamptz(3)
  endedAt     DateTime?   @db.Timestamptz(3)
  durationMs  Int?
  project     Project     @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Cascade)
  spans       AgentSpan[]

  @@unique([workspaceId, projectId, id])
  @@index([workspaceId, projectId, startedAt(sort: Desc)])
  @@index([workspaceId, projectId, subjectType, subjectId], map: "AgentRun_workspaceId_projectId_subject_idx")
}

model AgentSpan {
  id                  String   @id @db.Uuid
  workspaceId         String   @db.Uuid
  projectId           String   @db.Uuid
  runId               String   @db.Uuid
  parentSpanId        String?  @db.Uuid
  type                String
  name                String
  model               String?
  status              String
  errorCode           String?
  attempt             Int      @default(1)
  startedAt           DateTime @db.Timestamptz(3)
  durationMs          Int
  inputTokens         Int?
  cachedTokens        Int?
  cacheWriteTokens    Int?
  outputTokens        Int?
  reasoningTokens     Int?
  costMicros          BigInt?
  budgetReservationId String?  @db.Uuid
  providerResponseId  String?
  inputHash           String?
  outputHash          String?
  createdAt           DateTime @default(now()) @db.Timestamptz(3)
  run                 AgentRun @relation(fields: [workspaceId, projectId, runId], references: [workspaceId, projectId, id], onDelete: Cascade)

  @@index([workspaceId, projectId, runId])
}

model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  projectId   String   @db.Uuid
  actorId     String
  action      String
  resourceId  String
  metadata    Json
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  project     Project  @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Cascade)

  @@index([workspaceId, projectId, createdAt])
}

model KnowledgeDocument {
  id              String            @id @default(uuid()) @db.Uuid
  workspaceId     String            @db.Uuid
  projectId       String            @db.Uuid
  sourceId        String            @db.Uuid
  externalId      String
  activeVersionId String?           @db.Uuid
  canonicalUrl    String?
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  source          Entity            @relation(fields: [workspaceId, projectId, sourceId], references: [workspaceId, projectId, id], onDelete: Cascade)
  versions        DocumentVersion[]

  @@unique([workspaceId, projectId, sourceId, externalId])
  @@unique([workspaceId, projectId, id])
}

model DocumentVersion {
  id               String            @id @default(uuid()) @db.Uuid
  workspaceId      String            @db.Uuid
  projectId        String            @db.Uuid
  documentId       String            @db.Uuid
  version          Int
  title            String
  language         String
  contentHash      String
  text             String
  mimeType         String
  extractorVersion String
  sourceGeneration Int
  sourceUpdatedAt  DateTime?         @db.Timestamptz(3)
  fetchedAt        DateTime          @default(now()) @db.Timestamptz(3)
  validFrom        DateTime          @default(now()) @db.Timestamptz(3)
  validUntil       DateTime?         @db.Timestamptz(3)
  state            String            @default("prepared")
  document         KnowledgeDocument @relation(fields: [workspaceId, projectId, documentId], references: [workspaceId, projectId, id], onDelete: Cascade)
  chunks           KnowledgeChunk[]

  @@unique([documentId, version])
  @@unique([workspaceId, projectId, id])
  @@index([workspaceId, projectId, contentHash])
}

model KnowledgeChunk {
  id                String                   @id @default(uuid()) @db.Uuid
  workspaceId       String                   @db.Uuid
  projectId         String                   @db.Uuid
  documentVersionId String                   @db.Uuid
  position          Int
  heading           String
  anchor            String
  text              String
  chunkHash         String
  language          String
  tokenEstimate     Int
  searchVector      Unsupported("tsvector")?
  identifierVector  Unsupported("tsvector")?
  documentVersion   DocumentVersion          @relation(fields: [workspaceId, projectId, documentVersionId], references: [workspaceId, projectId, id], onDelete: Cascade)
  embeddings        ChunkEmbedding[]

  @@unique([documentVersionId, position])
  @@unique([workspaceId, projectId, id])
  @@index([workspaceId, projectId])
}

model ChunkEmbedding {
  id              String                @id @default(uuid()) @db.Uuid
  workspaceId     String                @db.Uuid
  projectId       String                @db.Uuid
  chunkId         String                @db.Uuid
  profile         String
  model           String
  dimensions      Int
  indexGeneration Int                   @default(1)
  vector          Unsupported("vector")
  createdAt       DateTime              @default(now()) @db.Timestamptz(3)
  index           KnowledgeIndex        @relation(fields: [workspaceId, projectId, profile, indexGeneration], references: [workspaceId, projectId, profile, generation], onDelete: Cascade)
  chunk           KnowledgeChunk        @relation(fields: [workspaceId, projectId, chunkId], references: [workspaceId, projectId, id], onDelete: Cascade)

  @@unique([chunkId, profile, indexGeneration])
  @@index([workspaceId, projectId, profile, indexGeneration])
}

model KnowledgeIndex {
  id               String           @id @default(uuid()) @db.Uuid
  workspaceId      String           @db.Uuid
  projectId        String           @db.Uuid
  generation       Int
  profile          String
  model            String
  dimensions       Int
  metric           String           @default("cosine")
  transformVersion String           @default("structure-v1")
  state            String           @default("building")
  manifest         Json
  manifestHash     String
  evaluation       Json?
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  activatedAt      DateTime?        @db.Timestamptz(3)
  project          Project          @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Cascade)
  embeddings       ChunkEmbedding[]

  @@unique([workspaceId, projectId, generation])
  @@unique([workspaceId, projectId, profile, generation])
  @@index([workspaceId, projectId, state])
}

// OAuth 2.1 authorization server for MCP clients (Track M, WP-M1). These are
// Better Auth's own models (jwt + oauth-provider + cimd plugins, version 1.7.10),
// so field names stay verbatim; the drift test in
// apps/api/tests/mcp-oauth-schema.integration.test.ts compares them with
// getAuthTables(). They belong to the auth set: orbit_auth only, no RLS, no
// orbit_app access. The Prisma adapter reaches them by the delegate name, which
// is the model name with a lower-case first letter (prisma.oauthClient).

/// Signing keys of the jwt plugin; the private key is stored encrypted.
model Jwks {
  id         String    @id
  publicKey  String
  privateKey String
  createdAt  DateTime  @db.Timestamptz(3)
  expiresAt  DateTime? @db.Timestamptz(3)
  alg        String?
  crv        String?

  @@map("jwks")
}

model OauthClient {
  id                               String                @id
  clientId                         String                @unique
  clientSecret                     String?
  clientDiscoveryId                String?
  disabled                         Boolean?              @default(false)
  skipConsent                      Boolean?
  enableEndSession                 Boolean?
  subjectType                      String?
  scopes                           String[]
  clientCredentialsScopes          String[]
  userId                           String?
  user                             User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt                        DateTime?             @db.Timestamptz(3)
  updatedAt                        DateTime?             @db.Timestamptz(3)
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         String[]
  tos                              String?
  policy                           String?
  softwareId                       String?
  softwareVersion                  String?
  softwareStatement                String?
  redirectUris                     String[]
  postLogoutRedirectUris           String[]
  backchannelLogoutUri             String?
  backchannelLogoutSessionRequired Boolean?
  tokenEndpointAuthMethod          String?
  applicationType                  String?
  jwks                             String?
  jwksUri                          String?
  grantTypes                       String[]
  responseTypes                    String[]
  requirePKCE                      Boolean?
  dpopBoundAccessTokens            Boolean?              @default(false)
  referenceId                      String?
  metadata                         Json?
  accessTokens                     OauthAccessToken[]
  refreshTokens                    OauthRefreshToken[]
  consents                         OauthConsent[]
  resources                        OauthClientResource[]

  @@index([userId])
  @@map("oauthClient")
}

model OauthRefreshToken {
  id                      String             @id
  token                   String             @unique
  clientId                String
  client                  OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]
  requestedUserInfoClaims String[]
  expiresAt               DateTime           @db.Timestamptz(3)
  createdAt               DateTime           @db.Timestamptz(3)
  revoked                 DateTime?          @db.Timestamptz(3)
  rotatedAt               DateTime?          @db.Timestamptz(3)
  rotationReplayResponse  String?
  rotationReplayExpiresAt DateTime?          @db.Timestamptz(3)
  authTime                DateTime?          @db.Timestamptz(3)
  confirmation            Json?
  scopes                  String[]
  accessTokens            OauthAccessToken[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@map("oauthRefreshToken")
}

model OauthAccessToken {
  id                      String             @id
  token                   String             @unique
  clientId                String
  client                  OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String?
  user                    User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]
  requestedUserInfoClaims String[]
  refreshId               String?
  refresh                 OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: Cascade)
  expiresAt               DateTime           @db.Timestamptz(3)
  createdAt               DateTime           @db.Timestamptz(3)
  revoked                 DateTime?          @db.Timestamptz(3)
  confirmation            Json?
  scopes                  String[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@index([refreshId])
  @@map("oauthAccessToken")
}

/// A user's consent for one client; `referenceId` is the workspace that was granted.
model OauthConsent {
  id                      String      @id
  clientId                String
  client                  OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId                  String?
  user                    User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  resources               String[]
  requestedUserInfoClaims String[]
  scopes                  String[]
  createdAt               DateTime    @db.Timestamptz(3)
  updatedAt               DateTime    @db.Timestamptz(3)

  @@index([clientId])
  @@index([userId])
  @@map("oauthConsent")
}

/// Used private_key_jwt assertions (jti is the id); rows only need to live until expiresAt.
model OauthClientAssertion {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(3)

  @@map("oauthClientAssertion")
}

model OauthResource {
  id                            String                @id
  identifier                    String                @unique
  name                          String
  accessTokenTtl                Int?
  refreshTokenTtl               Int?
  signingAlgorithm              String?
  signingKeyId                  String?
  allowedScopes                 String[]
  customClaims                  Json?
  dpopBoundAccessTokensRequired Boolean?              @default(false)
  disabled                      Boolean?              @default(false)
  createdAt                     DateTime?             @db.Timestamptz(3)
  updatedAt                     DateTime?             @db.Timestamptz(3)
  policyVersion                 Int?                  @default(1)
  metadata                      Json?
  clients                       OauthClientResource[]

  @@map("oauthResource")
}

model OauthClientResource {
  id         String        @id
  clientId   String
  client     OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resourceId String
  resource   OauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)
  metadata   Json?
  createdAt  DateTime?     @db.Timestamptz(3)

  @@unique([clientId, resourceId])
  @@index([clientId])
  @@index([resourceId])
  @@map("oauthClientResource")
}

/// What a user let an MCP client do in one workspace. Grants only narrow what the
/// user may do in the UI (docs 09 section 4.2); they never add rights.
/// `status` is pending | active | revoked. A partial unique index in the migration
/// (SQL only, Prisma cannot express it) allows one active grant per user, client
/// and workspace. `modules` empty means no module restriction. `clientId` and
/// `sessionId` are plain text: clients can be pruned and sessions rotate, while
/// grants and their events are kept as the record of what was allowed.
model McpGrant {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId           String
  workspaceId        String    @db.Uuid
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectIds         String[]  @db.Uuid
  allCurrentProjects Boolean   @default(false)
  scopes             String[]
  modules            String[]
  status             String
  sessionId          String?
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  activatedAt        DateTime? @db.Timestamptz(3)
  expiresAt          DateTime? @db.Timestamptz(3)
  revokedAt          DateTime? @db.Timestamptz(3)
  revokedBy          String?
  lastUsedAt         DateTime? @db.Timestamptz(3)

  @@index([userId, clientId, workspaceId, status])
}

/// Append-only record of grant changes. No foreign keys: it outlives grants,
/// users and workspaces.
model McpGrantEvent {
  id          String   @id @default(uuid()) @db.Uuid
  grantId     String?  @db.Uuid
  userId      String
  clientId    String
  workspaceId String?  @db.Uuid
  action      String
  detail      Json     @default("{}")
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([workspaceId, createdAt])
}
