{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eds-orbit:contract:customer-context:v1:customer-context-request",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "requestId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "description": "Unique per lookup; echoed in X-Orbit-Request-Id."
    },
    "requestedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 timestamp with offset."
    },
    "integrationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "description": "Opaque id of the Orbit integration; selects the provider's routing."
    },
    "acceptVersions": {
      "minItems": 1,
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "1.0"
        ]
      }
    },
    "subject": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "external_user_id"
        },
        "id": {
          "type": "string",
          "pattern": "^[^\\u0000-\\u001f\\u007f]{1,200}$",
          "description": "The product's own user id, exactly as it signs it for the Orbit widget."
        },
        "verification": {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "const": "widget_hmac",
              "description": "The product's backend signed this user id for the Orbit widget."
            },
            "verifiedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
              "description": "When Orbit verified the link to this user id."
            }
          },
          "required": [
            "method",
            "verifiedAt"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "id",
        "verification"
      ],
      "additionalProperties": false
    },
    "purpose": {
      "type": "string",
      "const": "support"
    },
    "include": {
      "description": "Sections to return; all when absent.",
      "minItems": 1,
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "subscription",
          "entitlements",
          "usage"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "requestId",
    "requestedAt",
    "integrationId",
    "acceptVersions",
    "subject",
    "purpose"
  ],
  "additionalProperties": false,
  "title": "CustomerContextRequest",
  "description": "Orbit's lookup of one verified customer. Carries no e-mail, name or Orbit tenant id."
}
