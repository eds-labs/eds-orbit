{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eds-orbit:contract:customer-context:v1:problem",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "description": "RFC 9457 problem type URI."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "status": {
      "type": "integer",
      "minimum": 400,
      "maximum": 599
    },
    "code": {
      "type": "string",
      "enum": [
        "invalid_request",
        "unsupported_version",
        "unauthenticated",
        "access_denied",
        "customer_not_found",
        "identity_not_verified",
        "rate_limited",
        "service_unavailable",
        "upstream_timeout"
      ]
    },
    "detail": {
      "description": "Short diagnostic text. Never customer data.",
      "type": "string",
      "maxLength": 500
    },
    "requestId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "retryAfterSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    }
  },
  "required": [
    "type",
    "title",
    "status",
    "code"
  ],
  "additionalProperties": false,
  "title": "CustomerContextProblem",
  "description": "RFC 9457 problem details (application/problem+json)."
}
