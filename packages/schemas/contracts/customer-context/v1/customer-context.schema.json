{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eds-orbit:contract:customer-context:v1:customer-context",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "system": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,62}$",
          "description": "Lower-case system identifier, e.g. `example-saas`."
        },
        "integrationId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        }
      },
      "required": [
        "system",
        "integrationId"
      ],
      "additionalProperties": false
    },
    "customer": {
      "type": "object",
      "properties": {
        "externalRef": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "external_user_id"
            },
            "id": {
              "type": "string",
              "pattern": "^[^\\u0000-\\u001f\\u007f]{1,200}$",
              "description": "The product's own user id, exactly as it signs it for the Orbit widget."
            }
          },
          "required": [
            "type",
            "id"
          ],
          "additionalProperties": false
        },
        "accountStatus": {
          "type": "string",
          "enum": [
            "active",
            "suspended",
            "closed",
            "unknown"
          ]
        }
      },
      "required": [
        "externalRef",
        "accountStatus"
      ],
      "additionalProperties": false
    },
    "subscription": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "trialing",
                "active",
                "past_due",
                "paused",
                "canceled",
                "expired",
                "none",
                "unknown"
              ]
            },
            "plan": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9_.:-]{0,127}$",
                      "description": "Opaque, stable key chosen by the provider. Orbit never interprets it."
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120,
                      "description": "Human-readable display text."
                    }
                  },
                  "required": [
                    "key",
                    "name"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "startedAt": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                  "description": "RFC 3339 timestamp with offset."
                },
                {
                  "type": "null"
                }
              ]
            },
            "currentPeriodStart": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                  "description": "RFC 3339 timestamp with offset."
                },
                {
                  "type": "null"
                }
              ]
            },
            "currentPeriodEnd": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                  "description": "RFC 3339 timestamp with offset."
                },
                {
                  "type": "null"
                }
              ],
              "description": "End of the paid or trial validity."
            },
            "trialEndsAt": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                  "description": "RFC 3339 timestamp with offset."
                },
                {
                  "type": "null"
                }
              ]
            },
            "cancellation": {
              "type": "object",
              "properties": {
                "state": {
                  "type": "string",
                  "enum": [
                    "none",
                    "scheduled",
                    "effective",
                    "unknown"
                  ],
                  "description": "scheduled: ends at effectiveAt (e.g. at period end). effective: already ended."
                },
                "requestedAt": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                      "description": "RFC 3339 timestamp with offset."
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "effectiveAt": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                      "description": "RFC 3339 timestamp with offset."
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "state",
                "requestedAt",
                "effectiveAt"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "status",
            "plan",
            "startedAt",
            "currentPeriodStart",
            "currentPeriodEnd",
            "trialEndsAt",
            "cancellation"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ],
      "description": "null exactly when freshness.availability.subscription is not `available`."
    },
    "entitlements": {
      "anyOf": [
        {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_.:-]{0,127}$",
                "description": "Opaque, stable key chosen by the provider. Orbit never interprets it."
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "description": "Human-readable display text."
              },
              "state": {
                "type": "string",
                "enum": [
                  "granted",
                  "denied",
                  "unknown"
                ],
                "description": "The effective state for this customer now."
              },
              "source": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "plan",
                      "addon",
                      "trial",
                      "override",
                      "promotion",
                      "unknown"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reason": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "not_in_plan",
                      "plan_inactive",
                      "limit_reached",
                      "disabled_by_admin",
                      "region_restricted",
                      "other",
                      "unknown"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Why a feature is denied; null when granted."
              },
              "expiresAt": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                    "description": "RFC 3339 timestamp with offset."
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "key",
              "label",
              "state",
              "source",
              "reason",
              "expiresAt"
            ],
            "additionalProperties": false
          }
        },
        {
          "type": "null"
        }
      ],
      "description": "null exactly when freshness.availability.entitlements is not `available`."
    },
    "usage": {
      "anyOf": [
        {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_.:-]{0,127}$",
                "description": "Opaque, stable key chosen by the provider. Orbit never interprets it."
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "description": "Human-readable display text."
              },
              "unit": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,31}$",
                "description": "e.g. credits, requests, seats."
              },
              "period": {
                "type": "string",
                "enum": [
                  "day",
                  "week",
                  "month",
                  "year",
                  "billing_period",
                  "lifetime",
                  "unknown"
                ]
              },
              "limit": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Non-negative quantity, or null when unknown. null never means 0."
              },
              "used": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Non-negative quantity, or null when unknown. null never means 0."
              },
              "remaining": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Non-negative quantity, or null when unknown. null never means 0."
              },
              "unlimited": {
                "description": "true: no limit applies. null: unknown.",
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "resetsAt": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                    "description": "RFC 3339 timestamp with offset."
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Next reset, or null when unknown or never."
              }
            },
            "required": [
              "key",
              "label",
              "unit",
              "period",
              "limit",
              "used",
              "remaining",
              "unlimited",
              "resetsAt"
            ],
            "additionalProperties": false
          }
        },
        {
          "type": "null"
        }
      ],
      "description": "null exactly when freshness.availability.usage is not `available`."
    },
    "freshness": {
      "type": "object",
      "properties": {
        "generatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
          "description": "RFC 3339 timestamp with offset."
        },
        "dataAsOf": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
              "description": "RFC 3339 timestamp with offset."
            },
            {
              "type": "null"
            }
          ],
          "description": "Age of the underlying product data, when known."
        },
        "maxAgeSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600,
          "description": "How long Orbit may show this snapshot."
        },
        "availability": {
          "type": "object",
          "properties": {
            "subscription": {
              "type": "string",
              "enum": [
                "available",
                "unavailable",
                "not_applicable",
                "not_requested"
              ],
              "description": "available: the section holds data. unavailable: the provider could not read it now. not_applicable: the product has no such concept. not_requested: excluded by `include`."
            },
            "entitlements": {
              "type": "string",
              "enum": [
                "available",
                "unavailable",
                "not_applicable",
                "not_requested"
              ],
              "description": "available: the section holds data. unavailable: the provider could not read it now. not_applicable: the product has no such concept. not_requested: excluded by `include`."
            },
            "usage": {
              "type": "string",
              "enum": [
                "available",
                "unavailable",
                "not_applicable",
                "not_requested"
              ],
              "description": "available: the section holds data. unavailable: the provider could not read it now. not_applicable: the product has no such concept. not_requested: excluded by `include`."
            }
          },
          "required": [
            "subscription",
            "entitlements",
            "usage"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "generatedAt",
        "dataAsOf",
        "maxAgeSeconds",
        "availability"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "source",
    "customer",
    "subscription",
    "entitlements",
    "usage",
    "freshness"
  ],
  "additionalProperties": false,
  "title": "CustomerContext",
  "description": "Product-neutral snapshot of one verified customer. Unknown values are null; a null amount is never 0."
}
